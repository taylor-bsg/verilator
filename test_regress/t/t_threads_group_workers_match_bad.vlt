`verilator_config
threads_group -module "tile" -workers 4->2: { 0 0 1 1 }
threads_group -module "til*" -workers 4->2: { 1 1 0 0 }
threads_group -module "acc" -workers 4->4: { 0 1 2 3 }
threads_group -module "chk" -workers 2->2: { 0 1 }
