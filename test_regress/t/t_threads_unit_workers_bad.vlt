`verilator_config
threads_unit -module "worker_tile" -workers 0->2: { }
threads_unit -module "worker_tile" -workers 1->0: { 0 }
threads_unit -module "worker_tile" -workers 4->2: { 0 1 0 }
threads_unit -module "worker_tile" -workers 1->2: { 2 }
threads_unit -module "worker_tile" -workers 1->2: { 'x }
threads_unit -module "worker_tile" -workers 1->2: { 64'h100000000 }
threads_unit -module "worker_tile" -workers 1->2: { 32'h80000000 }
